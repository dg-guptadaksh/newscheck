FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NEWSCHECK_DB=/tmp/newscheck-claims.sqlite3 \
    NEWSCHECK_REQUIRE_PERSISTENT_HISTORY=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 newscheck

WORKDIR /app
COPY --chown=newscheck:newscheck . .
RUN python -m pip install --no-cache-dir -r requirements-vercel.txt

USER newscheck
EXPOSE 80
CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
